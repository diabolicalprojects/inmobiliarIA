generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
}


// ─── Enums ──────────────────────────────────────────

enum IndustryType {
  REAL_ESTATE
  TRAVEL
}

enum SessionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_ADMIN
  AGENT
}

enum LLMProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
}

// ─── Auth & Users ───────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String   @db.VarChar(100)
  passwordHash String   @map("password_hash")
  role         UserRole @default(AGENT)
  agencyId     String?  @map("agency_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@map("users")
}

// ─── Core Multi-Tenant Models ──────────────────────

model Agency {
  id              String       @id @default(uuid())
  name            String       @db.VarChar(100)
  industryType    IndustryType @map("industry_type")
  aiSystemPrompt  String?      @map("ai_system_prompt") @db.Text
  llmProvider     LLMProvider  @default(OPENAI) @map("llm_provider")
  llmApiKey       String?      @map("llm_api_key") @db.Text
  llmModel        String?      @map("llm_model") @db.VarChar(100)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  users            User[]
  whatsappSessions WhatsappSession[]
  leads            Lead[]
  catalogItems     CatalogItem[]
  agents           Agent[]

  @@map("agencies")
}

model WhatsappSession {
  id                String        @id @default(uuid())
  agencyId          String        @map("agency_id")
  openwaSessionName String        @unique @map("openwa_session_name") @db.VarChar(255)
  status            SessionStatus @default(PENDING)
  qrCodeBase64      String?       @map("qr_code_base64") @db.Text
  connectedAt       DateTime?     @map("connected_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("whatsapp_sessions")
}

model Lead {
  id          String   @id @default(uuid())
  agencyId    String   @map("agency_id")
  phoneNumber String   @map("phone_number") @db.VarChar(25)
  name        String?  @db.VarChar(100)
  aiSummary   String?  @map("ai_summary") @db.Text
  isQualified Boolean  @default(false) @map("is_qualified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agency   Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  messages MessageHistory[]

  @@unique([agencyId, phoneNumber])
  @@index([agencyId])
  @@map("leads")
}

model MessageHistory {
  id        String      @id @default(uuid())
  leadId    String      @map("lead_id")
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("message_history")
}

model CatalogItem {
  id          String   @id @default(uuid())
  agencyId    String   @map("agency_id")
  title       String   @db.VarChar(255)
  description String   @db.Text
  price       Decimal? @db.Decimal(12, 2)
  location    String?  @db.VarChar(255)
  metadata    Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("catalog_items")
}

model Agent {
  id             String      @id @default(uuid())
  agencyId       String      @map("agency_id")
  name           String      @db.VarChar(100)
  description    String?     @db.Text
  systemPrompt   String?     @map("system_prompt") @db.Text
  llmProvider    LLMProvider @map("llm_provider")
  llmApiKey      String?     @map("llm_api_key") @db.Text
  llmModel       String?     @map("llm_model")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  agency         Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("agents")
}
